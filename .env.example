# Domains
REGISTRY_DOMAIN=registry.example.com
CONSOLE_DOMAIN=console.registry.example.com

# Postgres
POSTGRES_DB=registry_console
POSTGRES_USER=registry
POSTGRES_PASSWORD=change_me_postgres_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# R2 (production only)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=private-registry

# Registry token auth
REGISTRY_HTTP_SECRET=change_me_registry_http_secret
REGISTRY_SERVICE=registry.example.com
REGISTRY_TOKEN_ISSUER=private-registry-auth
REGISTRY_TOKEN_REALM=https://console.registry.example.com/api/registry/token

# API Server
API_PORT=3000
API_JWT_SECRET=change_me_console_session_secret
WEBHOOK_SECRET=change_me_registry_webhook_secret

# Initial admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# Dev overrides (used only in docker-compose.dev.yml)
DEV_REGISTRY_DOMAIN=localhost:5080
DEV_CONSOLE_DOMAIN=localhost:5081
